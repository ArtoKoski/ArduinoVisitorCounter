#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 20, 4);

const int sensorIn = 2;
const int sensorOut = 3;

int entered = 0;
int exited = 0;
int currentPeople = 0;

int state = 0; // 0 idle, 1 IN first, 2 OUT first

// debounce
const unsigned long debounceDelay = 200;

// LOCK (КЛЮЧОВЕ ВИПРАВЛЕННЯ)
const unsigned long lockTime = 800;

unsigned long lastInTrigger = 0;
unsigned long lastOutTrigger = 0;
unsigned long lastEventTime = 0;

// edge states
bool lastInState = LOW;
bool lastOutState = LOW;

void setup() {
lcd.init();
lcd.backlight();

pinMode(sensorIn, INPUT);
pinMode(sensorOut, INPUT);

lcd.setCursor(0, 0); lcd.print("IN: 0");
lcd.setCursor(0, 1); lcd.print("OUT: 0");
lcd.setCursor(0, 2); lcd.print("NOW: 0");
}

void loop() {
unsigned long now = millis();

bool inState = digitalRead(sensorIn);
bool outState = digitalRead(sensorOut);

// ---------------- IN ----------------
if (
inState == HIGH &&
lastInState == LOW &&
(now - lastInTrigger > debounceDelay) &&
(now - lastEventTime > lockTime)
) {
lastInTrigger = now;
lastEventTime = now;

if (state == 0) {
  state = 1;
}
else if (state == 2) {
  exited++;
  if (currentPeople > 0) currentPeople--;
  state = 0;
  updateDisplay();
}
}

// ---------------- OUT ----------------
if (
outState == HIGH &&
lastOutState == LOW &&
(now - lastOutTrigger > debounceDelay) &&
(now - lastEventTime > lockTime)
) {
lastOutTrigger = now;
lastEventTime = now;

if (state == 0) {
  state = 2;
}
else if (state == 1) {
  entered++;
  currentPeople++;
  state = 0;
  updateDisplay();
}
}

lastInState = inState;
lastOutState = outState;
}

void updateDisplay() {
lcd.setCursor(4, 0); lcd.print(" "); lcd.setCursor(4, 0); lcd.print(entered);
lcd.setCursor(5, 1); lcd.print(" "); lcd.setCursor(5, 1); lcd.print(exited);
lcd.setCursor(5, 2); lcd.print(" "); lcd.setCursor(5, 2); lcd.print(currentPeople);
}